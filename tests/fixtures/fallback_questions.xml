<?xml version="1.0" encoding="UTF-8"?>
<!--
    Plain fallback questions for the seed scripts.

    Questions are imported rather than inserted directly: since Moodle 4.0 a question also needs a
    question_bank_entry and a question_version, and a hand-built insert into {question} produces a
    row that quiz_add_quiz_question() rejects with
    "get_question_bank_entry(): Return value must be of type object, false returned".
    qformat_xml creates all three, so importing is both shorter and correct.

    Drop a STACK export in beside this file as stack_playwright.xml to seed real STACK questions.
-->
<quiz>
  <question type="shortanswer">
    <name><text>Scene one</text></name>
    <questiontext format="html"><text><![CDATA[<p>What is 1 + 1?</p>]]></text></questiontext>
    <defaultgrade>1</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <usecase>0</usecase>
    <answer fraction="100" format="plain_text"><text>2</text><feedback format="html"><text></text></feedback></answer>
  </question>
  <question type="shortanswer">
    <name><text>Scene two</text></name>
    <questiontext format="html"><text><![CDATA[<p>What is 2 + 2?</p>]]></text></questiontext>
    <defaultgrade>1</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <usecase>0</usecase>
    <answer fraction="100" format="plain_text"><text>4</text><feedback format="html"><text></text></feedback></answer>
  </question>
  <question type="shortanswer">
    <name><text>Scene three</text></name>
    <questiontext format="html"><text><![CDATA[<p>What is 3 + 3?</p>]]></text></questiontext>
    <defaultgrade>1</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <usecase>0</usecase>
    <answer fraction="100" format="plain_text"><text>6</text><feedback format="html"><text></text></feedback></answer>
  </question>
</quiz>
