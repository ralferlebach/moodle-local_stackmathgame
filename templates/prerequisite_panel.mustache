{{!
    @template local_stackmathgame/prerequisite_panel

    Prerequisite panel for the game settings page.

    Shows one row per requirement for running a game on this activity. The status is carried by
    a text label as well as a colour, because colour alone is not an accessible signal.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * summary string One-line verdict for the whole panel.
    * haserrors bool Whether at least one requirement is unmet in a blocking way.
    * haswarnings bool Whether at least one requirement produced a warning.
    * rows array List of check rows.
      * key string Stable identifier of the check.
      * label string Human-readable name of the requirement.
      * message string What was found.
      * statuslabel string Text form of the status.
      * isok bool Requirement met.
      * iswarning bool Met, but not as intended.
      * iserror bool Unmet in a blocking way.
      * hasfixurl bool Whether a link to the fix is available.
      * fixurl string Where the problem can be corrected.

    Example context (json):
    {
        "summary": "1 requirement is not met. The game will not start.",
        "haserrors": true,
        "haswarnings": false,
        "rows": [
            {
                "key": "behaviour",
                "label": "Question behaviour",
                "message": "The quiz uses \"deferredfeedback\" instead of \"stackmathgame\".",
                "statuslabel": "Not met",
                "isok": false,
                "iswarning": false,
                "iserror": true,
                "hasfixurl": true,
                "fixurl": "https://example.org/course/modedit.php?update=42"
            }
        ]
    }
}}
<div class="local-stackmathgame-prereq mb-3">
    <div class="alert {{#haserrors}}alert-danger{{/haserrors}}{{^haserrors}}{{#haswarnings}}alert-warning{{/haswarnings}}{{^haswarnings}}alert-success{{/haswarnings}}{{/haserrors}}" role="status">
        {{summary}}
    </div>
    <table class="table table-sm">
        <caption class="sr-only">{{#str}}prereq_heading, local_stackmathgame{{/str}}</caption>
        <thead>
            <tr>
                <th scope="col">{{#str}}prereq_col_requirement, local_stackmathgame{{/str}}</th>
                <th scope="col">{{#str}}prereq_col_status, local_stackmathgame{{/str}}</th>
                <th scope="col">{{#str}}prereq_col_detail, local_stackmathgame{{/str}}</th>
            </tr>
        </thead>
        <tbody>
        {{#rows}}
            <tr data-prereq="{{key}}">
                <th scope="row" class="font-weight-normal">{{label}}</th>
                <td>
                    <span class="badge {{#iserror}}badge-danger{{/iserror}}{{#iswarning}}badge-warning{{/iswarning}}{{#isok}}badge-success{{/isok}}">
                        {{statuslabel}}
                    </span>
                </td>
                <td>
                    {{message}}
                    {{#hasfixurl}}
                        <a href="{{fixurl}}" class="ml-2">{{#str}}prereq_fix, local_stackmathgame{{/str}}</a>
                    {{/hasfixurl}}
                </td>
            </tr>
        {{/rows}}
        </tbody>
    </table>
</div>
